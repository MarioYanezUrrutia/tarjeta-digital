# Django environment variables example
SECRET_KEY=
DEBUG=True
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Backend de Banexa (bot_ia): autenticación y banco de Terras.
# dev: http://localhost:8000/api — producción: https://api.kabymur.com/api
BANEXA_API_URL=http://localhost:8000/api

# --- Suscripción de tarjetas (Cobro) ---
# Precio mensual en Terras y duración de cada ciclo de suscripción.
TARJETA_PRECIO_TERRAS=5
TARJETA_DIAS_SUSCRIPCION=30
# Días antes del vencimiento en que se manda el aviso (Cobro-3).
TARJETA_DIAS_AVISO_PREVIO=5
# Bypass de desarrollo: con True, la página pública (/t/<slug>) se muestra
# aunque la tarjeta esté en borrador/vencida/cortada — sin esto, ninguna
# tarjeta se vería en dev hasta que exista el cobro real (Cobro-2).
# DEBE quedar en False en producción.
TARJETA_MODO_DEV=True

# --- Email (avisos de vencimiento/corte/pago — Cobro-3a) ---
# Sin nada configurado acá, los correos se imprimen en la consola del
# backend (EMAIL_BACKEND por defecto) — no se manda nada de verdad, ideal
# para dev. En producción, descomenta y completa con el SMTP real:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tarjeta Digital <no-reply@kabymur.com>

# URL pública del frontend, para el link de pago dentro de los correos —
# dev: http://localhost:5173, producción: el dominio real.
PUBLIC_BASE_URL=http://localhost:5173
