# Plantilla del .env de PRODUCCIÓN para tarjeta-digital (cPanel).
# Sin valores secretos reales — copiar al servidor como `.env` y completar
# ahí cada valor. Arquitectura asumida (ver reportes/DEPLOY_PREP.md):
# frontend Y backend sirven bajo el MISMO dominio, tarjeta.kabymur.com
# (backend montado en /api) — necesario porque el login (apps.cuentas)
# depende de una cookie httpOnly SameSite=Lax que no sobrevive un split
# a subdominios distintos sin cambiar el mecanismo de auth.

# --- Django core ---
# Generar una SECRET_KEY nueva y única para producción (nunca reusar la de
# dev), ej.: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# IMPORTANTE: en texto plano, no como comentario ni con espacios.
DEBUG=False

ALLOWED_HOSTS=tarjeta.kabymur.com

# CRÍTICO: en cPanel/Passenger la app ya queda montada bajo /api por fuera
# (ver arriba), así que las rutas internas de Django (config/urls.py) NO deben
# repetir ese prefijo o se duplica (/api/api/health/ en vez de /api/health/).
# Dejar vacío en producción. En dev se usa el default 'api/' (no hace falta
# declararlo en el .env local).
URL_PREFIX=

# --- Base de datos (Postgres del cPanel, base kabymur1_tarjetas ya creada) ---
# Formato: postgres://usuario:password@host:puerto/nombre_base
# PENDIENTE DE CONFIRMAR: si el Postgres de este cPanel es la misma versión
# 13 que usa Banexa, Django 6.1 (instalado acá) exige Postgres 14+ por
# defecto y necesitará el mismo workaround que aplicó bot_ia
# (config/pg_backend.py) — ver nota en DEPLOY_PREP.md.
DATABASE_URL=postgres://kabymur1_bot:CLAVE_AQUI@localhost:5432/kabymur1_tarjetas

# --- Backend de Banexa (bot_ia): autenticación y banco de Terras ---
BANEXA_API_URL=https://api.kabymur.com/api

# --- CORS / CSRF ---
# Si front y backend quedan en el MISMO origen (tarjeta.kabymur.com sirviendo
# tanto el build de React como /api/), esto es mayormente por seguridad — no
# hay llamadas cross-origin reales. Se deja igual configurado explícito.
CORS_ALLOWED_ORIGINS=https://tarjeta.kabymur.com
CSRF_TRUSTED_ORIGINS=https://tarjeta.kabymur.com

# --- Email real (avisos de vencimiento/corte/pago) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tarjeta Digital <no-reply@kabymur.com>

# --- URL pública (para los links de pago dentro de los correos) ---
PUBLIC_BASE_URL=https://tarjeta.kabymur.com

# --- Suscripción de tarjetas ---
TARJETA_PRECIO_TERRAS=5
TARJETA_DIAS_SUSCRIPCION=30
TARJETA_DIAS_AVISO_PREVIO=5

# CRÍTICO: en producción SIEMPRE False — con True, tarjetas en borrador o
# vencidas se muestran igual en la página pública, saltándose el cobro.
TARJETA_MODO_DEV=False

# --- Flow (Cobro-4) ---
# En produccion usar las credenciales REALES de la cuenta Flow
# (no el sandbox). Sacar de https://www.flow.cl -> tu cuenta -> API.
FLOW_API_URL=https://www.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Precio del plan Pro en CLP (editable también desde el admin de Django,
# este es solo el valor semilla si la config no existe aún)
TARJETA_PRECIO_PRO_CLP=0
