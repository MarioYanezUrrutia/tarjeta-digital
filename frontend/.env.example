# Backend de tarjeta-digital (Django) — dev: http://localhost:8010/api
VITE_API_BASE=

# Base pública de la tarjeta (para el QR y el link para compartir en el
# editor) — dev: http://localhost:5173, producción: el dominio real donde
# vive /t/<slug> (ej. https://tarjeta-digital.example.com). Sin esta
# variable, se usa el origen actual del navegador (window.location.origin)
# como respaldo.
VITE_PUBLIC_BASE_URL=

# Client ID de OAuth de Google (Google Cloud Console > Credenciales > ID de
# cliente de OAuth 2.0, tipo "Aplicación web"). Requiere localhost:5173 en
# "Orígenes autorizados de JavaScript". Sin esta variable, el botón de Google
# en /login y /registro se muestra deshabilitado.
VITE_GOOGLE_CLIENT_ID=
