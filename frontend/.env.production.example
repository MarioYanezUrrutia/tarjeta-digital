# Plantilla del .env de PRODUCCIÓN para el build del frontend
# (`npm run build` lee `.env.production` automáticamente si existe, o
# cualquier `.env` presente al momento del build — Vite las incrusta en el
# bundle estático, así que hay que tenerlas completas ANTES de compilar,
# no se pueden cambiar después en el servidor sin recompilar).
#
# Arquitectura asumida: backend montado en /api bajo el mismo dominio
# (ver reportes/DEPLOY_PREP.md) — por eso VITE_API_BASE usa el mismo
# dominio con /api, no un subdominio aparte.

VITE_API_BASE=https://tarjeta.kabymur.com/api
VITE_PUBLIC_BASE_URL=https://tarjeta.kabymur.com

# Mismo Client ID de Google OAuth que ya se usa en desarrollo (es público,
# no un secreto) — confirmar si aplica compartirlo con Banexa o si
# tarjeta-digital necesita uno propio.
VITE_GOOGLE_CLIENT_ID=
